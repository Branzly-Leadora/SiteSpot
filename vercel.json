{
  "functions": {
    "api/interni.js": { "includeFiles": "private/**" }
  },
  "rewrites": [
    { "source": "/rostlinka", "destination": "/rostlinka.html" },
    { "source": "/revenue-os", "destination": "/revenue-os.html" },
    { "source": "/obchodni-podminky", "destination": "/obchodni-podminky.html" },
    { "source": "/interni", "destination": "/api/interni" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/media/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(favicon.svg|og.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/demos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
